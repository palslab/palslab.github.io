---
import Base from '../../layouts/Base.astro';
import { news, fmtDate } from '../../lib/data';
---
<Base title="News">
  <section class="section">
    <div class="container">
      <h1 class="section-title">News archive</h1>
      <ul class="news-all">
        {news.map((n) => (
          <li><time datetime={n.date.toISOString().slice(0, 10)}>{fmtDate(n.date)}</time>
            <span>{n.link ? <a href={n.link}>{n.text}</a> : n.text}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .news-all { list-style: none; padding: 0; }
  .news-all li { display: grid; grid-template-columns: 7.5em 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .news-all time { color: var(--muted); }
</style>
