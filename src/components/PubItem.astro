---
import { site, pubLink, type Publication } from '../lib/data';
interface Props { pub: Publication }
const { pub } = Astro.props;
const coFirst = new Set(pub.roles?.co_first ?? []);
const corr = new Set(pub.roles?.corresponding ?? []);
const link = pubLink(pub);
---
<li data-year={pub.year} data-type={pub.type}>
  <span class="pub-authors">
    {pub.authors.map((a, i) => (
      <Fragment>
        {a === site.pi.name ? <strong>{a}</strong> : a}{coFirst.has(a) && <sup>†</sup>}{corr.has(a) && <sup>*</sup>}{i < pub.authors.length - 1 ? ', ' : ''}
      </Fragment>
    ))}.
  </span>
  <span class="pub-title"> {pub.title}{/[.!?]$/.test(pub.title) ? '' : '.'}</span>
  <span class="pub-meta"> <em>{pub.venue}</em>{pub.venue ? ', ' : ''}{pub.year}.{' '}
    {pub.status === 'under-review' && <span class="smallcaps"> Under review.</span>}
    {' '}{link ? <a href={link}>{pub.doi ? `doi:${pub.doi}` : link.replace(/^https?:\/\//, '')}</a> : pub.doi && <span>doi:{pub.doi}</span>}
    {pub.note && <span class="pub-note"> {pub.note}</span>}
  </span>
</li>
