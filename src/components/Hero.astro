---
import { site } from '../lib/data';
import { mosaic } from '../lib/mosaic';
const art = mosaic();
const f = (n: number) => +n.toFixed(1);
---
<section class="hero" aria-labelledby="hero-h">
  <div class="container">
    <div class="hero-text">
      <h1 id="hero-h" class="hero-tagline">{site.tagline}</h1>
      <p class="hero-welcome">{site.welcome}</p>
      <p class="hero-actions">
        <a class="button" href="#research">See our research</a>
        <a class="hero-link" href="#join">Join the lab</a>
      </p>
    </div>
  </div>
  <svg class="hero-art" viewBox={`0 0 ${art.w} ${art.h}`} preserveAspectRatio="xMinYMid slice" aria-hidden="true" focusable="false">
    {art.dots.map((d) => <circle cx={f(d.x)} cy={f(d.y)} r={f(d.r)} fill-opacity={f(d.o * 100) / 100} class={d.k} />)}
    <circle cx={art.ring.cx} cy={art.ring.cy} r={art.ring.r} class="ring" />
  </svg>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: var(--bg); border-bottom: 1px solid var(--line); min-height: 560px; display: flex; align-items: center; }
  .hero .container { width: 100%; position: relative; z-index: 1; }
  .hero-text { max-width: 520px; padding: 72px 0; }
  .hero-tagline { color: var(--accent); font-size: clamp(2.3rem, 4.6vw, 3.5rem); line-height: 1.06; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 24px; }
  .hero-welcome { font-size: 1.15rem; line-height: 1.65; color: var(--body); margin: 0 0 30px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin: 0; }
  .hero-link { font-weight: 600; text-decoration: none; }
  .hero-link:hover { text-decoration: underline; }
  .hero-art { position: absolute; top: 0; right: 0; bottom: 0; width: 50%; height: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 34%); mask-image: linear-gradient(90deg, transparent, #000 34%); }
  .rod, .cone { fill: var(--accent); }
  .patch { fill: var(--patch); }
  .ring { fill: none; stroke: var(--patch); stroke-width: 1.5; stroke-dasharray: 4 6; }
  @media (max-width: 860px) {
    .hero { display: block; min-height: 0; }
    .hero-text { padding: 48px 0 8px; max-width: none; }
    .hero-art { position: static; display: block; width: 100%; height: 260px;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%); mask-image: linear-gradient(180deg, transparent, #000 30%); }
  }
</style>
