---
import { site } from '../lib/data';
import { manifold } from '../lib/manifold';
const layout = (site.design?.hero ?? 'A').toUpperCase();
const art = manifold();
---
<section class:list={['hero', layout === 'B' ? 'hero-b' : 'hero-a']} aria-labelledby="hero-h">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1 id="hero-h" class="hero-tagline">{site.tagline}</h1>
      <p class="hero-welcome">{site.welcome}</p>
      <p class="hero-actions">
        <a class="button hero-cta" href="#research">See our research</a>
        <a class="hero-link" href="#join">Join the lab</a>
      </p>
    </div>
    <svg class="hero-art" viewBox={`0 0 ${art.w} ${art.h}`} aria-hidden="true" focusable="false">
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,1 L9,5 L0,9 z" class="art-arrow" />
        </marker>
      </defs>
      <g class="art-grid">{art.grid.map((d) => <path d={d} />)}</g>
      <g>{art.cells.map((c) => <circle cx={c.x.toFixed(1)} cy={c.y.toFixed(1)} r={c.r.toFixed(1)} class={`art-cell k${c.k}`} />)}</g>
      <path d={art.restore} class="art-restore" marker-end="url(#arrow)" />
      <path d={art.depart} class="art-depart" />
      <circle cx={art.basin.x} cy={art.basin.y} r="7" class="art-node" />
      <circle cx={art.end.x} cy={art.end.y} r="6" class="art-node art-node-end" />
    </svg>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero-tagline { font-size: clamp(2.1rem, 5.2vw, 3.6rem); line-height: 1.04; letter-spacing: 0.04em; font-weight: 800; margin: 0 0 22px; max-width: 12ch; }
  .hero-welcome { font-size: 1.2rem; line-height: 1.55; max-width: 48ch; margin: 0 0 26px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin: 0; }
  .hero-link { font-weight: 600; }

  /* art tokens (set per layout) */
  .art-grid path { fill: none; stroke: var(--art-grid); stroke-width: 0.8; }
  .art-cell.k0 { fill: var(--art-c0); }
  .art-cell.k1 { fill: var(--art-c1); }
  .art-cell.k2 { fill: var(--art-c2); }
  .art-depart { fill: none; stroke: var(--art-path); stroke-width: 3.2; stroke-linecap: round; }
  .art-restore { fill: none; stroke: var(--art-restore); stroke-width: 2.4; stroke-dasharray: 7 6; stroke-linecap: round; }
  .art-arrow { fill: var(--art-restore); }
  .art-node { fill: var(--art-node); stroke: var(--art-path); stroke-width: 2.5; }
  .art-node-end { fill: var(--art-path); }

  /* Layout A — colour band, text left, art right */
  .hero-a { background: var(--accent-ink); color: #fff; padding: 76px 0 72px;
    --art-grid: rgba(255,255,255,0.13); --art-c0: rgba(255,255,255,0.85); --art-c1: rgba(255,255,255,0.45);
    --art-c2: var(--warm-on-dark); --art-path: var(--warm-on-dark); --art-restore: #fff; --art-node: var(--accent-ink); }
  .hero-a .hero-inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: 32px; align-items: center; }
  .hero-a .hero-tagline { color: #fff; }
  .hero-a .hero-welcome { color: rgba(255,255,255,0.92); }
  .hero-a .hero-cta { background: #fff; color: var(--accent-ink); }
  .hero-a .hero-cta:hover { background: var(--accent-soft); color: var(--accent-ink); }
  .hero-a .hero-link { color: #fff; }
  .hero-a .hero-link:hover { color: var(--warm-on-dark); }

  /* Layout B — white, art spans the width, headline sits in its open corner */
  .hero-b { background: #fff; padding: 40px 0 24px; border-bottom: 1px solid var(--line);
    --art-grid: color-mix(in srgb, var(--accent) 16%, transparent); --art-c0: var(--accent); --art-c1: color-mix(in srgb, var(--accent) 45%, #fff);
    --art-c2: var(--warm); --art-path: var(--warm); --art-restore: var(--accent); --art-node: #fff; }
  .hero-b .hero-inner { display: grid; grid-template-columns: 1fr; }
  .hero-b .hero-text, .hero-b .hero-art { grid-area: 1 / 1; }
  .hero-b .hero-text { position: relative; z-index: 1; align-self: start; padding-top: 32px; }
  .hero-b .hero-art { width: 70%; justify-self: end; margin-right: -6%; align-self: center; }
  .hero-b .hero-tagline { color: var(--accent); }
  .hero-b .hero-welcome { color: var(--ink); max-width: 44ch; }
  .hero-b .hero-text { max-width: 30rem; background: linear-gradient(90deg, #fff 82%, rgba(255,255,255,0)); padding-right: 2rem; }

  @media (max-width: 860px) {
    .hero-a .hero-inner { grid-template-columns: 1fr; }
    .hero-a .hero-art { max-width: 520px; }
    .hero-b .hero-text, .hero-b .hero-art { grid-area: auto; }
    .hero-b .hero-art { width: 100%; margin: 8px 0 0; }
    .hero-b .hero-text { max-width: none; background: none; padding-right: 0; }
  }
</style>
