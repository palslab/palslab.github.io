---
import { site, showSection } from '../lib/data';
import { mosaic } from '../lib/mosaic';
// site.yaml `hero_art`: "concept" (the lab concept illustration band) or "mosaic" (generated retina mosaic)
const mode = site.hero_art === 'mosaic' ? 'mosaic' : 'concept';
const art = mode === 'mosaic' ? mosaic() : null;
const f = (n: number) => +n.toFixed(1);
const alt = 'Illustration of the lab\'s research: a phylogeny of fruit-fly species with gene-expression curves, single-cell clusters of diverse cell types, a space of cell states in which photoreceptors change state, and a cross-section of the retina with rods and cones.';
---
<section class:list={['hero', `hero-${mode}`]} aria-labelledby="hero-h">
  {mode === 'concept' && (
    <figure class="hero-figure">
      <picture>
        <source media="(max-width: 700px)" srcset="/images/lab-concept-m-900.webp" width="900" height="619" />
        <img src="/images/lab-concept-1440.webp" srcset="/images/lab-concept-960.webp 960w, /images/lab-concept-1440.webp 1440w, /images/lab-concept-2172.webp 2172w"
             sizes="100vw" width="2172" height="724" alt={alt} fetchpriority="high" decoding="async" />
      </picture>
    </figure>
  )}
  <div class="container">
    <div class="hero-text">
      <div class="hero-head">
        <h1 id="hero-h" class="hero-tagline">{site.lab_name}</h1>
        <p class="hero-sub">{site.tagline}</p>
      </div>
      <div class="hero-body">
        <p class="hero-welcome">{site.welcome}</p>
        <p class="hero-actions">
          <a class="button" href="#research">See our research</a>
          {showSection('join') && <a class="hero-link" href="#join">Join the lab</a>}
        </p>
      </div>
    </div>
  </div>
  {mode === 'mosaic' && (
    <svg class="hero-art" viewBox={`0 0 ${art!.w} ${art!.h}`} preserveAspectRatio="xMinYMid slice" aria-hidden="true" focusable="false">
      {art!.dots.map((d) => <circle cx={f(d.x)} cy={f(d.y)} r={f(d.r)} fill-opacity={f(d.o * 100) / 100} class={d.k} />)}
      <circle cx={art!.ring.cx} cy={art!.ring.cy} r={art!.ring.r} class="ring" />
    </svg>
  )}
</section>

<style>
  .hero { position: relative; overflow: hidden; background: var(--bg); border-bottom: 1px solid var(--line); }
  .hero .container { width: 100%; position: relative; z-index: 1; }
  .hero-tagline { color: var(--accent); font-size: clamp(2.3rem, 4.6vw, 3.5rem); line-height: 1.06; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 16px; }
  .hero-sub { font-size: clamp(1.1rem, 1.8vw, 1.3rem); font-weight: 600; color: var(--ink); line-height: 1.4; margin: 0; }
  .hero-welcome { font-size: 1.1rem; line-height: 1.65; color: var(--body); margin: 0 0 26px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin: 0; }
  .hero-link { font-weight: 600; text-decoration: none; }
  .hero-link:hover { text-decoration: underline; }

  /* Concept illustration: full-width band at the top, text in two columns below */
  .hero-concept .hero-text { display: grid; grid-template-columns: 5fr 7fr; gap: 24px 56px; align-items: start; padding: 28px 0 64px; }
  .hero-figure { margin: 0; }
  .hero-figure img { display: block; width: 100%; height: auto; max-height: 520px; object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent), linear-gradient(180deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent), linear-gradient(180deg, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect; }

  /* Mosaic (alternative) */
  .hero-mosaic { min-height: 560px; display: flex; align-items: center; }
  .hero-mosaic .hero-text { max-width: 520px; padding: 72px 0; }
  .hero-mosaic .hero-sub { margin: -8px 0 22px; }
  .hero-art { position: absolute; top: 0; right: 0; bottom: 0; width: 50%; height: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 34%); mask-image: linear-gradient(90deg, transparent, #000 34%); }
  .rod, .cone { fill: var(--accent); }
  .patch { fill: var(--patch); }
  .ring { fill: none; stroke: var(--patch); stroke-width: 1.5; stroke-dasharray: 4 6; }

  @media (max-width: 860px) {
    .hero-concept .hero-text { grid-template-columns: 1fr; padding: 20px 0 44px; }
    .hero-concept .hero-sub { margin-bottom: 4px; }
    .hero-mosaic { display: block; min-height: 0; }
    .hero-mosaic .hero-text { padding: 48px 0 8px; max-width: none; }
    .hero-art { position: static; display: block; width: 100%; height: 260px;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%); mask-image: linear-gradient(180deg, transparent, #000 30%); }
  }
</style>
